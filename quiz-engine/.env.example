# Application Settings
DEBUG=false
SECRET_KEY=your-secret-key-change-this-in-production
APP_NAME="Quiz Engine"

# Database Configuration
DATABASE_URL=postgresql://quizuser:quizpass123@localhost:5432/quizdb
MONGODB_URL=mongodb://admin:mongopass123@localhost:27017/quizdb?authSource=admin
REDIS_URL=redis://localhost:6379/0

# Vector Database Configuration
VECTOR_DB_TYPE=chromadb
CHROMADB_HOST=localhost
CHROMADB_PORT=8000
# For Pinecone (alternative)
# PINECONE_API_KEY=your_pinecone_key
# PINECONE_ENVIRONMENT=your_pinecone_env

# LLM Configuration
OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_key_here
LLM_MODEL=gpt-3.5-turbo
LLM_TEMPERATURE=0.7

# Embedding Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# CORS Settings
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:8080"]

# File Upload Settings
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=[".pdf", ".docx", ".txt", ".md"]

# Quiz Settings
DEFAULT_QUESTIONS_PER_QUIZ=10
MAX_QUESTIONS_PER_QUIZ=50
QUIZ_TIME_LIMIT_MINUTES=30

# RAG Settings
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=5

# Authentication
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Logging
LOG_LEVEL=INFO